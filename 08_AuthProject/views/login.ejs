<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Login Page</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900">
        <div class="pt-20">
            <h1 class="text-4xl text-center text-slate-200 font-bold">Login</h1>
        </div>

        <div class="flex justify-center">
            <div class="w-full max-w-80 lg:max-w-md mt-10">
                <form action="/login" method="post" class="text-slate-200 bg-slate-800 p-5 rounded-lg">
                    <label for="">Username</label>
                    <input type="text" placeholder="Enter UserName" required name="userName"
                        class="bg-gray-800 px-2 py-2 border border-gray-400 valid:border-green-600 rounded-lg block mb-4 outline-none w-full">
                    <label for="">Password</label>
                    <input type="text" placeholder="Enter Password" required name="password" class=" bg-gray-800 px-2 py-2 border border-gray-400 valid:border-green-600 rounded-lg block
                        mb-4 outline-none w-full">

                    <input type="submit" value="Login"
                        class="bg-green-500 px-4 py-2 rounded-lg text-slate-100 font-bold cursor-pointer">
                </form>
            </div>
        </div>
    </div>
</body>

</html>