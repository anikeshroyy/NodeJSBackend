<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Auth Test</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900">
        <!-- Navbar -->
        <nav class="bg-zinc-800 text-slate-200 px-5 py-4">
            <div class="max-w-6xl mx-auto">
                <div class="flex items-center justify-between">
                    <!-- Logo -->
                    <h2 class="text-xl sm:text-2xl font-semibold">Logo</h2>
                    <!-- Navigation -->
                    <ul class="flex items-center gap-4 sm:gap-6 text-sm sm:text-base">
                        <li>
                            <a href="/login" class="hover:text-blue-400 transition">Login</a>
                        </li>
                        <li>
                            <a href="#" class="hover:text-blue-400 transition">About</a>
                        </li>
                        <li>
                            <a href="#" class="hover:text-blue-400 transition">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <!-- Hero Section -->
        <main class="px-5">
            <div class="min-h-[calc(100vh-72px)] flex flex-col items-center justify-center">
                <!-- Content -->
                <div class="text-center w-full max-w-3xl">
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl text-slate-200 font-bold leading-tight mb-5">
                        Explore users based in India
                    </h1>
                    <p class="text-base sm:text-lg lg:text-2xl text-slate-400 leading-relaxed">
                        Lorem ipsum dolor sit amet consectetur adipisicing elit.
                        Ut voluptas dolorum sit facilis.
                    </p>
                </div>
                <!-- Buttons -->
                <div class="flex flex-col sm:flex-row items-center gap-4 mt-8 w-full sm:w-auto">
                    <a href="/signup"
                        class="w-full sm:w-40 text-center py-3 sm:py-4 bg-green-500 hover:bg-green-600 text-zinc-900 font-semibold rounded-lg transition">
                        Create Account
                    </a>
                    <a href="/login"
                        class="w-full sm:w-40 text-center py-3 sm:py-4 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg transition">
                        Login
                    </a>
                </div>
            </div>
        </main>
    </div>
</body>

</html>