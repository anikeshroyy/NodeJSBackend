<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sign Up | Vibely</title>

    <link rel="stylesheet" href="/styles/style.css">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-slate-950 text-slate-200">
    <main class="min-h-screen flex items-center justify-center px-4 py-10">
        <div class="w-full max-w-sm">
            <!-- Logo -->
            <div class="text-center mb-4">
                <a href="/" class="font-space text-4xl font-bold tracking-tight">
                    Vibely
                </a>
            </div>

            <!-- Signup Card -->
            <div
                class="bg-slate-900/80 border border-slate-800 rounded-2xl p-7 sm:p-8 shadow-2xl shadow-blue-950/20 backdrop-blur">
                <!-- Heading -->
                <div class="mb-7">
                    <h1 class="font-space text-2xl lg:text-3xl font-bold text-slate-100">
                        Create your account
                    </h1>
                    <p class="font-dm text-[15px] lg:text-sm text-slate-400 mt-2">
                        Join Vibely and start sharing your story.
                    </p>
                </div>

                <!-- Signup Form -->
                <form action="/signup" method="POST" class="space-y-3">
                    <!-- Full Name -->
                    <div>
                        <label for="fullName" class="block font-poppins text-sm font-medium text-slate-300 mb-2">
                            Full Name
                        </label>

                        <input type="text" id="fullName" name="fullName" placeholder="Enter your full name"
                            autocomplete="name" maxlength="50" required
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>


                    <!-- Username -->
                    <div>
                        <label for="username" class="block font-poppins text-sm font-medium text-slate-300 mb-2">
                            Username
                        </label>

                        <input type="text" id="username" name="username" placeholder="Choose a username"
                            autocomplete="username" minlength="3" maxlength="20" required
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block font-poppins text-sm font-medium text-slate-300 mb-2">
                            Email Address
                        </label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email"
                            required
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>

                    <!-- Password -->
                    <div>
                        <label for="password" class="block font-poppins text-sm font-medium text-slate-300 mb-2">
                            Password
                        </label>
                        <input type="password" id="password" name="password" placeholder="Create a strong password"
                            autocomplete="new-password" minlength="4" required
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">

                        <p class="font-dm text-xs text-slate-500 mt-2">
                            Password must be at least 4 characters.
                        </p>
                    </div>
                    <!-- Submit -->
                    <button type="submit"
                        class="w-full cursor-pointer bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-poppins font-semibold rounded-xl py-3 transition duration-200 shadow-lg shadow-blue-600/20">
                        Create Account
                    </button>
                </form>


                <!-- Login -->
                <div class="relative my-7">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-800"></div>
                    </div>
                    <div class="relative flex justify-center">
                        <span class="bg-slate-900 px-4 font-dm text-sm text-slate-500">
                            Already on Vibely?
                        </span>
                    </div>
                </div>

                <a href="/login"
                    class="block w-full text-center border border-slate-700 hover:border-blue-500 hover:text-blue-400 text-slate-300 font-poppins font-medium rounded-xl py-3 transition duration-200">
                    Log In
                </a>
            </div>
        </div>
    </main>

</body>

</html>