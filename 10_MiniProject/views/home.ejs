<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibely</title>
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="bg-slate-950 w-full min-h-screen">
        <!-- Navbar -->
        <nav class="border-b border-slate-800 bg-slate-950/80 backdrop-blur">
            <div class="max-w-6xl mx-auto px-5 py-4 flex items-center justify-between">
                <!-- Logo -->
                <a href="/" class="font-space text-3xl text-slate-400 font-bold">
                    Vibely<span class="text-blue-500">.</span>
                </a>
                <!-- Navigation -->
                <div class="flex items-center gap-5">
                    <!-- <a href="/" class="font-poppins text-sm text-slate-400 hover:text-blue-400 transition">
                        Home
                    </a> -->
                    <div class="relative flex items-center justify-center group">

                        <% if (!user) { %>

                            <a href="/login" class="font-poppins text-sm text-slate-400 hover:text-blue-400 transition">
                                Login
                            </a>

                            <% } else { %>

                                <!-- Profile button -->
                                <button class="flex items-center gap-2 cursor-pointer" type="button">

                                    <img class="w-9 h-9 rounded-full border-2 border-blue-800 object-cover"
                                        src="<%= user.profilePicture %>" alt="<%= user.name %>">
                                </button>

                                <!-- Dropdown -->
                                <div class="absolute right-0 top-full mt-2 w-40 bg-slate-900 border border-slate-800 rounded-lg shadow-lg
                   opacity-0 invisible group-hover:opacity-100 group-hover:visible
                   transition-all duration-200 hover:overflow-hidden">

                                    <a href="/profile"
                                        class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-blue-400">
                                        Profile
                                    </a>

                                    <a href="/logout"
                                        class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-red-400">
                                        Logout
                                    </a>

                                </div>

                                <% } %>

                    </div>
                </div>
            </div>
        </nav>
        <main class="flex flex-col justify-center pt-40">
            <div class="flex items-center justify-center flex-col">
                <div class="text-center w-full max-w-80 lg:max-w-4xl">
                    <h1 class="hero-title text-4xl lg:text-7xl font-bold text-slate-200 mb-4">
                        Every <span class="text-blue-500 text-3xl lg:text-5xl">Thought</span> has a Story.
                    </h1>

                    <p class="hero-paragraph text-lg text-slate-300 w-full max-w-3xl mx-auto">
                        Vibely is your space to speak freely, share your moments, and connect
                        with people who make the journey more meaningful.
                    </p>
                </div>

                <div class="mt-8">
                    <button><a href="/create/post" class="bg-green-500 text-slate-800 font-bold text-lg px-6 py-2">Start
                            Creating Posts</a></button>
                </div>
            </div>

            <section class="flex justify-center my-30">
                <% if (posts && posts.length> 0) { %>
                    <div class="flex flex-col lg:flex-row flex-wrap gap-5 px-5">
                        <% posts.forEach(post=> { %>
                            <div class="bg-slate-900 border border-slate-800
                            w-full lg:w-[320px]
                            rounded-2xl p-5">

                                <!-- User -->
                                <div class="flex items-center gap-3">

                                    <img src="<%= post.userProfilePicture %>"
                                        class="w-10 h-10 rounded-full object-cover" alt="">

                                    <div>
                                        <h3 class="font-poppins font-semibold text-sm text-slate-200">
                                            <%= post.user_UserName %>
                                        </h3>

                                        <p class="font-dm text-xs text-slate-500">
                                            <%= new Date(post.postTime).toLocaleString('en-IN', { day: '2-digit' ,
                                                month: 'short' , year: 'numeric' , hour: '2-digit' , minute: '2-digit'
                                                }) %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Content -->
                                <p class="font-dm text-slate-300 leading-7 mt-4">
                                    <%= post.postContent %>
                                </p>

                                <!-- Image -->
                                <% if (post.postImage) { %>
                                    <img src="<%= post.postImage %>" alt="Post image"
                                        class="mt-4 w-full aspect-square object-cover rounded-xl">
                                    <% } %>

                                        <!-- Actions -->
                                        <div
                                            class="flex items-center gap-6 mt-5 pt-4 border-t border-slate-800 text-slate-300">
                                            <button>♡ Like</button>

                                            <button>💬 Comment</button>

                                            <button>↗ Share</button>
                                        </div>
                            </div>

                            <% }) %>

                    </div>

                    <% } else { %>

                        <div class="text-center py-16">
                            <h1>No posts available</h1>
                        </div>

                        <% } %>

            </section>
        </main>
    </div>
</body>

</html>