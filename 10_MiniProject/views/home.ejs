<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibely</title>
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="bg-slate-950 w-full min-h-screen">
        <nav class="bg-slate-900/80 text-slate-200 py-4">
            <div class="flex items-center justify-around">
                <div>
                    <a href="/" class="text-3xl font-bold">Vibely</a>
                </div>
                <div class="lg:block hidden">
                    <ul class="flex items-center gap-2 text-xl font-semibold">
                        <li><a href=""
                                class="hover:text-zinc-200 duration-200 px-4 py-1.5 hover:bg-blue-600 rounded-3xl">About</a>
                        </li>
                        <li><a href=""
                                class="hover:text-zinc-200 duration-200 px-4 py-1.5 hover:bg-blue-600 rounded-3xl">Contact</a>
                        </li>
                        <li><a href=""
                                class="hover:text-zinc-200 duration-200 px-4 py-1.5 hover:bg-blue-600 rounded-3xl">Post</a>
                        </li>
                        <li><a href="/login"
                                class="hover:text-zinc-200 duration-200 px-4 py-1.5 hover:bg-blue-600 rounded-3xl">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="flex justify-center pt-40">
            <div class="flex items-center justify-center flex-col">
                <div class="text-center w-full max-w-80 lg:max-w-4xl">

                    <h1 class="hero-title text-4xl lg:text-7xl font-bold text-slate-200 mb-4">
                        Every <span class="text-blue-500 text-3xl lg:text-5xl">Thought</span> has a Story.
                    </h1>

                    <p class="hero-paragraph text-lg text-slate-300 w-full max-w-3xl mx-auto">
                        Vibely is your space to speak freely, share your moments, and connect
                        with people who make the journey more meaningful.
                    </p>

                </div>

                <div class="mt-8">
                    <button><a href="/signup" class="bg-green-500 text-slate-800 font-bold text-lg px-6 py-2">Explore
                            Now</a></button>
                </div>
            </div>
        </main>
    </div>
</body>

</html>