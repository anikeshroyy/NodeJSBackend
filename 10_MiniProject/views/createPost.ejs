<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Post</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Poppins:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap"
        rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        space: ['"Space Grotesk"', 'sans-serif'],
                        poppins: ['Poppins', 'sans-serif'],
                        dm: ['"DM Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #020617;
            /* slate-950 */
        }
    </style>
</head>

<body class="text-slate-200 min-h-screen">

    <!-- Navbar -->
    <nav class="border-b border-slate-800 sticky top-0 bg-slate-950/80 backdrop-blur z-10">
        <div class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between">
            <a href="/" class="font-space text-xl font-bold">Logo</a>
            <a href="/posts" class="font-poppins text-sm text-slate-400 hover:text-slate-200 transition">← Back to
                Posts</a>
        </div>
    </nav>

    <section class="max-w-2xl mx-auto mt-8 px-4 pb-16">

        <h2 class="font-space text-2xl font-bold mb-5">
            Create Post
        </h2>

        <form action="/create/post" method="POST" enctype="multipart/form-data"
            class="bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col gap-5">

            <!-- User info -->
            <div class="flex items-center gap-3">
                <img src="<%= user.profilePicture %>" alt=""
                    class="w-10 h-10 rounded-full object-cover border border-slate-700">
                <div>
                    <h3 class="font-poppins font-semibold text-sm">
                        <%= user.name %>
                    </h3>
                    <p class="font-dm text-xs text-slate-500">
                        @<%= user.username %>
                    </p>
                </div>
            </div>

            <!-- Post content -->
            <textarea name="postContent" rows="4" placeholder="What's on your mind?" required
                class="font-dm text-sm text-slate-200 bg-slate-950 border border-slate-800 rounded-xl p-4 resize-none placeholder-slate-600 focus:outline-none focus:border-blue-600 transition"></textarea>

            <!-- Image upload -->
            <div>
                <label for="postImage"
                    class="flex flex-col items-center justify-center gap-2 border border-dashed border-slate-700 rounded-xl py-8 cursor-pointer hover:border-blue-600 hover:bg-slate-950/50 transition">
                    <span class="text-2xl">🖼</span>
                    <span class="font-dm text-sm text-slate-500" id="uploadLabel">Click to upload an image</span>
                    <span class="font-dm text-xs text-slate-600">PNG, JPG up to 5MB</span>
                </label>
                <input type="file" name="postImage" id="postImage" accept="image/*" class="hidden"
                    onchange="previewImage(event)">

                <!-- Preview -->
                <div class="relative">
                    <img id="imagePreview" src="" alt=""
                        class="hidden mt-4 rounded-xl w-full max-h-96 object-cover border border-slate-800">
                    <button type="button" id="removeImageBtn" onclick="removeImage()"
                        class="hidden absolute top-2 right-2 bg-slate-950/80 text-slate-200 text-xs px-2 py-1 rounded-lg hover:bg-red-500/80 transition">
                        ✕ Remove
                    </button>
                </div>
            </div>

            <!-- Error message -->
            <p id="formError" class="hidden font-dm text-xs text-red-400"></p>

            <!-- Actions -->
            <div class="flex justify-end gap-3 pt-2 border-t border-slate-800">
                <a href="/posts"
                    class="font-poppins text-sm text-slate-400 hover:text-slate-200 px-4 py-2 rounded-xl transition">
                    Cancel
                </a>
                
                <button type="submit" id="submitBtn"
                    class="font-poppins text-sm bg-blue-600 hover:bg-blue-500 px-5 py-2 rounded-xl transition shadow-lg shadow-blue-600/20">
                    Post
                </button>
            </div>

        </form>

    </section>

    <script>
        const fileInput = document.getElementById('postImage');
        const preview = document.getElementById('imagePreview');
        const removeBtn = document.getElementById('removeImageBtn');
        const uploadLabel = document.getElementById('uploadLabel');
        const form = document.querySelector('form');
        const formError = document.getElementById('formError');
        const textarea = document.querySelector('textarea[name="postContent"]');

        function previewImage(event) {
            const file = event.target.files[0];
            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                showError('Image must be smaller than 5MB.');
                fileInput.value = '';
                return;
            }

            preview.src = URL.createObjectURL(file);
            preview.classList.remove('hidden');
            removeBtn.classList.remove('hidden');
            uploadLabel.textContent = file.name;
        }

        function removeImage() {
            fileInput.value = '';
            preview.src = '';
            preview.classList.add('hidden');
            removeBtn.classList.add('hidden');
            uploadLabel.textContent = 'Click to upload an image';
        }

        function showError(message) {
            formError.textContent = message;
            formError.classList.remove('hidden');
        }

        form.addEventListener('submit', (e) => {
            formError.classList.add('hidden');
            if (!textarea.value.trim() && !fileInput.value) {
                e.preventDefault();
                showError('Write something or add an image before posting.');
            }
        });
    </script>

</body>

</html>