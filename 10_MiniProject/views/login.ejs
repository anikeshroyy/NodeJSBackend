<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | Vibely</title>

    <link rel="stylesheet" href="/styles/style.css">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-slate-950 text-slate-200">
    <main class="min-h-screen flex items-center justify-center px-4 py-10">
        <div class="w-full max-w-sm">
            <!-- Logo -->
            <div class="text-center mb-4">
                <a href="/" class="font-space text-4xl font-bold tracking-tight">
                    Vibely
                </a>
            </div>

            <!-- Login Card -->
            <div
                class="bg-slate-900/80 border border-slate-800 rounded-2xl p-7 sm:p-8 shadow-2xl shadow-blue-950/20 backdrop-blur">

                <!-- Heading -->
                <div class="mb-7">
                    <h1 class="font-space text-2xl lg:text-3xl font-bold text-slate-100">
                        Welcome back
                    </h1>

                    <p class="font-dm text-slate-400 mt-2">
                        Log in to continue sharing your story.
                    </p>
                </div>

                <!-- Login Form -->
                <form action="/login" method="POST" class="space-y-3">
                    <!-- Username -->
                    <div>

                        <label for="username" class="block font-poppins text-sm font-medium text-slate-300 mb-2">
                            Username
                        </label>

                        <input type="text" id="username" name="username" placeholder="Enter your username"
                            autocomplete="username" required
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>

                    <!-- Password -->
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label for="password" class="block font-poppins text-sm font-medium text-slate-300">
                                Password
                            </label>
                            <a href="/forgot-password"
                                class="font-dm text-sm text-blue-400 hover:text-blue-300 transition">
                                Forgot password?
                            </a>
                        </div>

                        <input type="password" id="password" name="password" placeholder="Enter your password"
                            autocomplete="current-password" required
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>

                    <!-- Login Button -->
                    <button type="submit"
                        class="mt-4 cursor-pointer w-full bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-poppins font-semibold rounded-xl py-3 transition duration-200 shadow-lg shadow-blue-600/20">
                        Log In
                    </button>
                </form>

                <!-- Signup Divider -->
                <div class="relative my-7">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-800"></div>
                    </div>

                    <div class="relative flex justify-center">
                        <span class="bg-slate-900 px-4 font-dm text-sm text-slate-500">
                            New to Vibely?
                        </span>
                    </div>
                </div>

                <!-- Signup Button -->
                <a href="/signup"
                    class="block w-full text-center border border-slate-700 hover:border-blue-500 hover:text-blue-400 text-slate-300 font-poppins font-medium rounded-xl py-3 transition duration-200">
                    Create an Account
                </a>
            </div>
        </div>
    </main>

</body>

</html>