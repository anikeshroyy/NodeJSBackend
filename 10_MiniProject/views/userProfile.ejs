<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile | <%= user.name %>
    </title>
    <meta name="description" content="<%= user.bio %>">
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-slate-950 text-slate-200">
    <!-- Navbar -->
    <nav class="border-b border-slate-800 bg-slate-950/80 backdrop-blur">
        <div class="max-w-6xl mx-auto px-5 py-4 flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="font-space text-3xl font-bold">
                Vibely<span class="text-blue-500">.</span>
            </a>
            <!-- Navigation -->
            <div class="flex items-center gap-5">
                <a href="/" class="font-poppins text-sm text-slate-400 hover:text-blue-400 transition">Home</a>
                <a href="/profile" class="font-poppins text-sm text-blue-400">Profile</a>
                <a href="/logout" class="font-poppins text-sm text-slate-400 hover:text-red-400 transition">Logout</a>
            </div>
        </div>
    </nav>
    <!-- Profile -->
    <main class="max-w-6xl mx-auto px-5 py-10">
        <!-- Profile Header -->
        <section class="bg-slate-900 border border-slate-800 rounded-3xl p-5 sm:p-7 lg:p-8">
            <!-- Profile Info -->
            <div class="flex flex-col sm:flex-row sm:items-start gap-6 sm:gap-7">
                <!-- Avatar -->
                <div class="shrink-0 flex justify-center sm:justify-start">
                    <div class="relative">
                        <% if (user.profilePicture) { %>
                            <img src="<%= user.profilePicture %>" alt="<%= user.name %>"
                                class="w-24 h-24 sm:w-28 sm:h-28 lg:w-32 lg:h-32 rounded-full object-cover border-2 border-slate-700 p-1.5 shadow-lg shadow-blue-500/10">
                            <% } else { %>
                                <div
                                    class="w-24 h-24 sm:w-28 sm:h-28 lg:w-32 lg:h-32 rounded-full bg-linear-to-br from-blue-600 to-cyan-400 flex items-center justify-center border-2 border-slate-700 shadow-lg shadow-blue-500/10">
                                    <span class="font-space text-3xl sm:text-4xl font-bold text-white">
                                        <%= user.name.charAt(0).toUpperCase() %>
                                    </span>
                                </div>
                                <% } %>
                    </div>
                </div>
                <!-- User Info -->
                <div class="flex-1 min-w-0 text-center sm:text-left">
                    <!-- Name -->
                    <h1 class="font-space text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-100 truncate">
                        <%= user.name %>
                    </h1>
                    <!-- Username + Email -->
                    <div class="mt-2 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
                        <span
                            class="font-dm inline-flex items-center justify-center sm:justify-start gap-1 text-sm sm:text-base text-blue-400 font-medium">
                            @<%= user.username %>
                        </span>
                        <% if (user.email) { %>
                            <span class="hidden sm:inline text-slate-700">•</span>
                            <span
                                class="font-dm inline-flex items-center justify-center sm:justify-start gap-1.5 text-xs sm:text-sm text-slate-500 truncate">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0 mt-1 lg:mt-1.5"
                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="4" width="20" height="16" rx="2" />
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                                </svg>
                                <span class="truncate">
                                    <%= user.email %>
                                </span>
                            </span>
                            <% } %>
                    </div>
                    <!-- Bio -->
                    <div class="mt-4">
                        <% if (user.bio) { %>
                            <p class="font-dm text-sm sm:text-base text-slate-300 leading-7 max-w-2xl mx-auto sm:mx-0">
                                <%= user.bio %>
                            </p>
                            <% } else { %>
                                <p class="font-caveat text-xl sm:text-2xl text-slate-500">
                                    No bio added yet!
                                </p>
                                <% } %>
                    </div>
                </div>
            </div>
            <!-- Bottom Action -->
            <div class="mt-7 pt-5 border-t border-slate-800">
                <a href="/profile/edit"
                    class="flex items-center justify-center gap-2 w-full border border-slate-700 hover:border-blue-500 hover:bg-blue-500/5 hover:text-blue-400 text-slate-300 rounded-xl px-5 py-2.5 font-poppins text-sm transition duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                    </svg>
                    Edit Profile
                </a>
            </div>
        </section>

        <section class="mt-8">
            <div class="flex items-center justify-between mb-5">

                <h2 class="font-space text-2xl font-bold">
                    Your Posts
                </h2>

                <a href="/create/post">
                    <button
                        class="font-poppins cursor-pointer text-sm bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded-xl transition shadow-lg shadow-blue-600/20">
                        + Create Post
                    </button>
                </a>

            </div>

            <% if (post && post.length> 0) { %>

                <div class="flex flex-col lg:flex-row flex-wrap justify-around gap-5 ">

                    <% post.forEach(post=> { %>

                        <div
                            class="bg-slate-900 border border-slate-800 w-full lg:w-[355px] rounded-2xl p-5 hover:border-slate-700 transition">

                            <!-- User -->
                            <div class="flex items-center justify-between">

                                <div class="flex items-center gap-3">

                                    <img src="<%= post.userProfilePicture %>" alt=""
                                        class="w-10 h-10 rounded-full object-cover border border-slate-700">

                                    <div>
                                        <h3 class="font-poppins font-semibold text-sm">
                                            <%= post.user_UserName %>
                                        </h3>

                                        <p class="font-dm text-xs text-slate-500">
                                            @<%= post.user_UserName %> · <%= new
                                                    Date(post.postTime).toLocaleString('en-IN', { day: '2-digit' ,
                                                    month: 'short' , year: 'numeric' , hour: '2-digit' ,
                                                    minute: '2-digit' }) %>
                                        </p>
                                    </div>

                                </div>
                                <a href=""><button
                                        class="font-dm text-md cursor-pointer flex items-center gap-1 text-slate-500 hover:text-red-400 transition px-2 py-1 rounded-lg hover:bg-red-500/10">
                                        🗑
                                    </button></a>
                            </div>

                            <!-- Content -->
                            <p class="font-dm text-slate-300 leading-7 mt-4">
                                <%= post.postContent %>
                            </p>

                            <!-- Image -->
                            <% if (post.postImage) { %>

                                <img src="<%= post.postImage %>" alt="Post image"
                                    class="mt-4 w-full aspect-square object-cover rounded-xl border border-slate-800">

                                <% } %>

                                    <!-- Actions -->
                                    <div class="flex items-center gap-6 mt-5 pt-4 border-t border-slate-800">

                                        <button class="font-dm text-sm text-slate-500 hover:text-pink-400 transition">
                                            ♡ Like
                                        </button>

                                        <button class="font-dm text-sm text-slate-500 hover:text-blue-400 transition">
                                            💬 Comment
                                        </button>

                                        <button class="font-dm text-sm text-slate-500 hover:text-green-400 transition">
                                            ↗ Share
                                        </button>

                                    </div>

                        </div>

                        <% }) %>

                </div>

                <% } else { %>

                    <div class="text-center py-16">
                        <h1 class="font-poppins text-slate-500">
                            No posts available
                        </h1>
                    </div>

                    <% } %>
        </section>
    </main>
</body>

</html>