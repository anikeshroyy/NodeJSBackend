<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile | Vibely</title>
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-slate-950 text-slate-200">
    <!-- Navbar -->
    <nav class="border-b border-slate-800 bg-slate-950/80 backdrop-blur">
        <div class="max-w-6xl mx-auto px-5 py-4 flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="font-space text-3xl font-bold">
                Vibely<span class="text-blue-500">.</span>
            </a>
            <!-- Navigation -->
            <div class="flex items-center gap-5">
                <a href="/" class="font-poppins text-sm text-slate-400 hover:text-blue-400 transition">
                    Home
                </a>
                <a href="/profile" class="font-poppins text-sm text-slate-400 hover:text-blue-400 transition">
                    Profile
                </a>
                <a href="/logout" class="font-poppins text-sm text-slate-400 hover:text-red-400 transition">
                    Logout
                </a>
            </div>
        </div>
    </nav>
    <!-- Main -->
    <main class="min-h-[calc(100vh-73px)] flex items-center justify-center px-5 py-10">
        <div class="w-full max-w-2xl">
            <!-- Heading -->
            <div class="mb-7">
                <h1 class="font-space text-4xl font-bold text-slate-100 mt-1">
                    Edit Profile
                </h1>
                <p class="font-dm text-slate-500 mt-2">
                    Update your Vibely profile information.
                </p>
            </div>
            <!-- Form Card -->
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl shadow-blue-950/20">

                <form action="/uploadProfilePicure" method="post" enctype="multipart/form-data" class="mb-6">
                    <!-- Profile Picture -->
                    <div>
                        <label class="block font-poppins text-sm font-medium text-slate-300 mb-3">
                            Profile Picture
                        </label>

                        <div
                            class="flex flex-col items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-2xl p-6">
                            <!-- Avatar Preview -->
                            <div class="relative group">
                                <img src="<%= user.profilePicture %>" alt="Profile picture"
                                    class="w-28 h-28 rounded-full border-2 border-blue-500 object-cover p-1 shadow-lg shadow-blue-500/10">
                                <div class="absolute inset-0 rounded-full bg-black/40 opacity-0 group-hover:opacity-100 
                            flex items-center justify-center transition duration-200 pointer-events-none">
                                    <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24"
                                        stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </div>
                            </div>

                            <!-- Custom File Input -->
                            <div class="w-full flex flex-col items-center gap-3">
                                <label for="profilePicture" class="w-full text-center cursor-pointer bg-slate-950 border border-dashed border-slate-700 
                           rounded-xl px-4 py-4 font-dm text-sm text-slate-400 outline-none transition duration-200
                           hover:border-blue-500 hover:text-slate-200 hover:bg-slate-900">
                                    <span id="fileLabel">Click to choose an image, or drag it here</span>
                                    <input type="file" id="profilePicture" name="profilePicture" accept="image/*"
                                        class="hidden"
                                        onchange="document.getElementById('fileLabel').textContent = this.files[0] ? this.files[0].name : 'Click to choose an image, or drag it here'">
                                </label>

                                <input type="submit" value="Upload" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 border border-blue-500 rounded-xl 
                           font-dm text-sm text-white font-medium transition duration-200 
                           hover:shadow-lg hover:shadow-blue-500/20 active:scale-95">
                            </div>
                        </div>
                    </div>
                </form>

                <form action="/profile/edit" method="POST" class="space-y-6">
                    <!-- Name -->
                    <div>
                        <label for="name" class="block font-poppins text-sm font-medium text-slate-300 mb-2">
                            Full Name
                        </label>
                        <input type="text" id="name" name="name" value="<%= user.name %>" placeholder="Enter your name"
                            required
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>
                    <!-- Email -->
                    <div>
                        <label for="email" class="block font-poppins text-sm font-medium text-slate-300 mb-2">
                            Email Address
                        </label>
                        <input type="email" id="email" name="email" value="<%= user.email %>"
                            placeholder="you@example.com" disabled
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>
                    <!-- Bio -->
                    <div>
                        <label for="bio" class="block font-poppins text-sm font-medium text-slate-300 mb-2">
                            Bio
                        </label>
                        <textarea id="bio" name="bio" rows="4" maxlength="160"
                            placeholder="Tell people a little about yourself..."
                            class="w-full resize-none bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 font-dm text-slate-200 placeholder:text-slate-600 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"><%= user.bio || '' %></textarea>
                        <p class="font-dm text-xs text-slate-600 mt-2">
                            Keep it short — maximum 160 characters.
                        </p>
                    </div>
                    <!-- Buttons -->
                    <div class="flex flex-col-reverse sm:flex-row gap-3 pt-2">
                        <a href="/profile"
                            class="w-full sm:w-auto text-center border border-slate-700 hover:border-slate-500 text-slate-300 font-poppins font-medium rounded-xl px-6 py-3 transition">
                            Cancel
                        </a>
                        <button type="submit"
                            class="w-full sm:w-auto sm:ml-auto bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-poppins font-semibold rounded-xl px-7 py-3 transition shadow-lg shadow-blue-600/20">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>

</html>