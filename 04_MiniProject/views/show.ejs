<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 flex justify-center">
        <div
            class="text-white bg-zinc-800 p-5 rounded-lg border border-white min-w-80 lg:max-w-2xl flex flex-col gap-4">
            <div>
                <a href="../" class="text-blue-500 font-semibold bg-zinc-700 px-4 py-2 rounded-lg">Go Back To Home</a>
            </div>

            <div class="bg-zinc-600 py-4 px-2 rounded-lg">
                <h1 class="text-3xl mb-2 font-semibold">
                    <%= filename %>
                </h1>
                <p class="text-2xl text-red">
                    <%= fileData %>
                </p>
            </div>
        </div>
    </div>
</body>

</html>