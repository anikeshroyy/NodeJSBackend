<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update <%= filename %></title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 flex justify-center">
        <div
            class="text-white bg-zinc-800 p-5 rounded-lg border border-white min-w-80 lg:max-w-2xl flex flex-col gap-4">
            <div>
                <a href="../" class="text-blue-500 font-semibold bg-zinc-700 px-4 py-2 rounded-lg">Go Back To Home</a>
            </div>

            <div class="">
                <form action="/edit" method="post" class="text-white">
                    <input type="text" placeholder="Enter Notes Title" name="oldName" value="<%= filename %>"
                        class="bg-zinc-800 block px-6 py-4 rounded-lg w-full my-4 border border-blue-400 text-slate-400">
                    <input type="text" placeholder="Enter New Filename" name="newName"
                        class="bg-zinc-800 block px-6 py-4 rounded-lg w-full my-4 border border-blue-400">
                    <input type="submit" value="Update Filename"
                        class="bg-orange-500 font-semibold text-white w-full rounded-lg py-2 cursor-pointer text-2xl">
                </form>
            </div>
        </div>
    </div>
</body>

</html>