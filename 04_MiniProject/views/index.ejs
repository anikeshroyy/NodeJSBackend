<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Myy App</title>
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>
    <div class="bg-zinc-900 w-full min-h-screen">
        <div>
            <h1 class="text-center text-white text-4xl font-bold pt-20">Note Taker App</h1>
        </div>

        <div class="m-10">
            <form action="/create" method="post" class="text-white">
                <input type="text" placeholder="Enter Notes Title" name="title"
                    class="bg-zinc-800 block px-6 py-4 rounded-lg w-full my-4">
                <textarea type="text" placeholder="Enter Notes Description" name="description"
                    class="bg-zinc-800 block px-6 py-4 rounded-lg w-full my-4 resize-none"></textarea>
                <input type="submit" value="Create Task"
                    class="bg-blue-500 font-semibold text-white w-full rounded-lg py-2 cursor-pointer text-2xl">
            </form>
        </div>

        <div class="m-10 flex gap-4 lg:gap-9 items-center flex-wrap">

            <% if(files.length> 0){ %>
                <% files.forEach((val)=> { %>
                    <div class="bg-zinc-800 text-white p-5 rounded-lg w-70 lg:w-65">
                        <h1 class="text-2xl">
                            <%= val %>
                        </h1>
                        <div class="flex items-center justify-between mt-4">
                            <a href="/files/<%= val %>" class="text-blue-500">Read More</a>
                            <a href="/edit/<%= val %>" class="text-orange-500">Edit Filename</a>
                        </div>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <h2 class="text-3xl text-white">No Files Yet</h2>
                            <% } %>

        </div>
    </div>


</body>

</html>