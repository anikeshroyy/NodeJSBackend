<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div class="bg-slate-900 w-full min-h-screen">
        <div>
            <div class="pt-10">
                <h1 class="text-slate-200 text-center text-4xl font-bold">Create User</h1>
            </div>

            <div class="flex justify-center mt-6">
                <form action=""
                    class="text-slate-200 w-full max-w-80 lg:max-w-1/4 rounded-xl border border-white p-5 shadow-lg shadow-slate-700">
                    <label for="">Enter Full Name</label>
                    <input type="text" placeholder="Enter Name"
                        class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">
                    <label for="">Enter User Name</label>
                    <input type="text" placeholder="Enter UserName"
                        class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">
                    <label for="">Enter User Email</label>
                    <input type="text" placeholder="Enter Email"
                        class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">

                    <input type="submit" value="Create User"
                        class="w-full bg-blue-500 text-white text-lg font-semibold rounded-lg text-center py-2 cursor-pointer">
                </form>
            </div>
        </div>
    </div>
</body>

</html>