<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div class="bg-slate-900 w-full min-h-screen">
        <div>
            <div class="pt-10">
                <h1 class="text-slate-200 text-center text-4xl font-bold">Create User</h1>
            </div>

            <div class="flex justify-center mt-6">
                <form action="/create" method="post"
                    class="text-slate-200 w-full max-w-80 lg:max-w-6xl rounded-xl bg-slate-700 p-5">
                    <label for="">Enter Full Name</label>
                    <input type="text" placeholder="Enter Name" name="name"
                        class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">
                    <label for="">Enter User Name</label>
                    <input type="text" placeholder="Enter UserName" name="userName"
                        class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">
                    <label for="">Enter User Email</label>
                    <input type="text" placeholder="Enter Email" name="userEmail"
                        class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">

                    <input type="submit" value="Create User"
                        class="w-full bg-blue-500 text-white text-lg font-semibold rounded-lg text-center py-2 cursor-pointer shadow-sm shadow-slate-500">
                </form>
            </div>

            <div class="flex justify-center mt-10 pb-10">
                <div class="w-full max-w-80 lg:max-w-6xl bg-gray-700 p-5 rounded-xl">
                    <div class="flex items-center justify-center gap-6 flex-wrap">
                        <% if(allUser.length> 0){ %>
                            <% allUser.forEach((users)=> { %>

                                <div
                                    class="bg-slate-800 text-slate-400 w-full max-w-65 p-4 rounded-lg shadow-sm shadow-slate-400">

                                    <h1 class="text-slate-200 text-lg font-semibold">
                                        User Details
                                    </h1>

                                    <h2>
                                        Name - <%= users.name %>
                                    </h2>

                                    <h3>
                                        Username - <%= users.userName %>
                                    </h3>

                                    <h3>
                                        Email - <%= users.userEmail %>
                                    </h3>

                                    <div class="mt-4 flex justify-between items-center">
                                        <a href="/edit/<%= users._id  %>"
                                            class="text-center px-4 py-1 rounded-md bg-green-500 text-white font-semibold">Edit
                                            User</a>
                                        <a href="/delete/<%= users._id  %>"
                                            class="text-center px-4 py-1 rounded-md bg-red-500 text-white font-semibold">Delete
                                            User</a>
                                    </div>

                                </div>

                                <% }); %>

                                    <% } else{ %>
                                        <h2 class="text-center text-lg font-semibold text-slate-200">Try adding users to
                                            get updated user from Database</h2>
                                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>