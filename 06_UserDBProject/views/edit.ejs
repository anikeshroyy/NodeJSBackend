<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="bg-slate-900 w-full min-h-screen">
        <div class="flex justify-center pt-6">
            <form action="/edit/<%= updateUser._id %>" method="post"
                class="text-slate-200 w-full max-w-80 lg:max-w-6xl rounded-xl bg-slate-700 p-5">

                <a href="../" class="text-white bg-orange-500 rounded-lg w-40 mb-6 px-4 py-2 block ">Go Back to Home</a>
                <label for="">Enter Full Name</label>
                <input type="text" placeholder="Enter Name" name="name"
                    class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">
                <label for="">Enter User Name</label>
                <input type="text" placeholder="Enter UserName" name="userName"
                    class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">
                <label for="">Enter User Email</label>
                <input type="text" placeholder="Enter Email" name="userEmail"
                    class="block border rounded-lg bg-slate-800 px-4 py-2 mb-2 w-full outline-none">

                <input type="submit" value="Update User"
                    class="w-full bg-blue-500 text-white text-lg font-semibold rounded-lg text-center py-2 cursor-pointer shadow-md shadow-slate-500">
            </form>
        </div>
    </div>
</body>

</html>