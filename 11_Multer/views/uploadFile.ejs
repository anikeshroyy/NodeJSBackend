<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Picture</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #f2f2f2;
            font-family: Arial, sans-serif;
        }

        .card {
            width: 350px;
            padding: 30px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .card h1 {
            margin-bottom: 8px;
            font-size: 24px;
        }

        .card p {
            color: #777;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .profile-image {
            width: 140px;
            height: 140px;
            margin: 0 auto 20px;
            border-radius: 50%;
            overflow: hidden;
            border: 4px solid #eee;
        }

        .profile-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .upload-box {
            display: block;
            padding: 15px;
            border: 2px dashed #ccc;
            border-radius: 10px;
            cursor: pointer;
            margin-bottom: 20px;
            color: #666;
        }

        .upload-box:hover {
            border-color: #333;
            color: #333;
        }

        #imageInput {
            display: none;
        }

        .upload-btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background: #111;
            color: white;
            font-size: 15px;
            cursor: pointer;
        }

        .upload-btn:hover {
            background: #333;
        }
    </style>
</head>

<body>
    <div class="card">
        <h1>Update Picture</h1>
        <p>Choose a new profile picture</p>

        <div class="profile-image">
            <img id="preview" src="<%= user.profilePic %>" alt="Profile Picture">
        </div>

        <div>
            <h1>
                <%= user.name %>
            </h1>
        </div>


        <form action="/create" method="post">
            <input type="text" name="name">
            <input type="submit" value="create">


        </form>

        <form action="/upload" method="post" enctype="multipart/form-data">

            <label for="imageInput" class="upload-box">
                Choose a picture
            </label>

            <input id="imageInput" type="file" name="image" accept="image/*">

            <input class="upload-btn" type="submit" value="Update Picture">

        </form>

    </div>

</body>

</html>